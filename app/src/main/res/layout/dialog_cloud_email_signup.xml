<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/cloud_signup_email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:autofillHints="emailAddress"
            android:background="@android:drawable/edit_text"
            android:hint="@string/cloud_email_placeholder"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="12dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/cloud_signup_code_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="smsOTPCode"
                android:background="@android:drawable/edit_text"
                android:hint="@string/cloud_email_code_placeholder"
                android:inputType="number"
                android:maxLength="8"
                android:maxLines="1"
                android:padding="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/cloud_signup_send_code_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/cloud_email_send_code" />
        </LinearLayout>

        <EditText
            android:id="@+id/cloud_signup_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:autofillHints="password"
            android:background="@android:drawable/edit_text"
            android:hint="@string/cloud_password_placeholder"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/cloud_signup_nickname_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:autofillHints="username"
            android:background="@android:drawable/edit_text"
            android:hint="@string/cloud_email_nickname_placeholder"
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/cloud_signup_submit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cloud_email_signup_submit" />

        <Button
            android:id="@+id/cloud_signup_back_btn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cloud_email_back_to_login" />
    </LinearLayout>
</ScrollView>
